# Optional overrides for dockyrd.service (copy to /etc/dockyrd/dockyrd.env)

# Briefing §19: owners must enable 2FA before using the panel (recommended in production).
dockyrd_REQUIRE_OWNER_2FA=1

# GitHub PAT (classic: public_repo, or fine-grained: read access to this repository).
# Avoids unauthenticated api.github.com rate limits on update checks and install.sh.
# dockyrd_GITHUB_TOKEN=ghp_...

# Public URL for email links when not set in Instance settings.
# Also used by dy-proxy (Caddy) for the dashboard hostname on first boot — set this
# via install.sh --dashboard-domain or here before the first `dockyrd serve`.
# dockyrd_PUBLIC_URL=https://panel.example.com

# Let's Encrypt contact when instance ACME email is empty (pair with dockyrd_PUBLIC_URL).
# dockyrd_ACME_EMAIL=ops@example.com
